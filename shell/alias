# Creature comforts
alias c="clear"
alias ll="ls -lh"
alias la="ls -lah"
path() { echo "${1:-$PATH}" | tr ':' '\n'; }

if command -v gls >/dev/null 2>&1; then
  alias ls="gls --color=auto --group-directories-first"
else
  export CLICOLOR=1
fi

# Git
ggbda() {
  local branch
  while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    git branch -D -- "$branch"
  done < <(git for-each-ref --format='%(refname:short) %(upstream) %(upstream:track)' refs/heads/ | awk '$2 != "" && $3 == "[gone]" { print $1 }')
}
alias ggwtprune='git-worktree-prune-merged'
alias ggwt="git worktree list"

# Pi
# NODE_EXTRA_CA_CERTS must stay set: Cloudflare WARP TLS-inspects outbound HTTPS,
# so Node needs the Gateway CA to verify gateway.ai.cloudflare.com. It *appends*
# to Node's bundled roots, so it's safe. SSL_CERT_FILE is unset because it
# *replaces* the OpenSSL trust store with the single-cert Cloudflare bundle.
alias pi="env -u SSL_CERT_FILE -- pi"

# Zellij
alias hiive-local="zellij attach hiive-local 2>/dev/null || zellij -n hiive -s hiive-local"
