#!/bin/sh
set -eu

usage() {
  cat << 'EOF'
usage: setup-worktree [branch-name]

Creates or reuses a git worktree using `hiive worktree add` and opens it in a
new Zellij session (editor + ai + shell tabs).

Arguments:
  branch-name  Git branch name to create or open. If omitted, an interactive
               picker is shown (delegates to hiive worktree add's fzf picker).

Examples:
  setup-worktree nick/HIIVE-123-do-a-thing
EOF
}

sanitize_branch_name() {
  printf '%s' "$1" |
    tr '/[:space:]' '--' |
    tr '[:upper:]' '[:lower:]' |
    tr -cd '[:alnum:]._-' |
    sed 's/--*/-/g; s/^-//; s/-$//'
}

derive_zellij_session_name() {
  # Zellij caps session names at 24 characters.
  # Format: repo_branch (stripping username prefix from branch, e.g. nick/iss-123 → iss-123).
  # If the result exceeds 24 chars, truncate to 19 + a 4-char hash so names stay unique.
  repo_name="$1"
  branch_name="$2"

  branch_short="$(printf '%s' "$branch_name" | sed 's|^[^/]*/||')"
  branch_safe="$(sanitize_branch_name "$branch_short")"
  raw="${repo_name}_${branch_safe}"

  if [ "${#raw}" -le 24 ]; then
    printf '%s' "$raw"
  else
    suffix="$(printf '%s' "$raw" | shasum | cut -c1-4)"
    prefix="$(printf '%s' "$raw" | cut -c1-19 | sed 's/[-_]*$//')"
    printf '%s-%s' "$prefix" "$suffix"
  fi
}

open_in_zellij() {
  worktree_path="$1"
  repo_name="$2"
  branch_name="$3"
  session_name="$(derive_zellij_session_name "$repo_name" "$branch_name")"

  cd "$worktree_path"
  session_info="$(zellij list-sessions --no-formatting 2>/dev/null | grep "^$session_name" || true)"

  if [ -n "$session_info" ]; then
    if printf '%s' "$session_info" | grep -q "EXITED"; then
      zellij delete-session "$session_name"
    elif [ -n "${ZELLIJ:-}" ]; then
      echo "Worktree ready at: $worktree_path"
      echo "Run: zellij attach $session_name"
      return 0
    else
      zellij attach "$session_name"
      return 0
    fi
  fi

  if [ -n "${ZELLIJ:-}" ]; then
    echo "Worktree ready at: $worktree_path"
    echo "Run: zellij -s $session_name -n worktree"
    return 0
  fi

  zellij -s "$session_name" -n worktree
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  usage
  exit 0
fi

for cmd in hiive zellij git jq; do
  if ! command -v "$cmd" > /dev/null 2>&1; then
    echo "Missing required command: $cmd" >&2
    exit 1
  fi
done

repo_root="$(git rev-parse --show-toplevel 2> /dev/null || true)"

if [ -z "$repo_root" ]; then
  echo "Run this script from inside a git repository." >&2
  exit 1
fi

repo_name="$(basename "$repo_root")"
branch_name="${1:-}"

# Delegate worktree creation to hiive CLI. It prints the path to stdout.
if [ -n "$branch_name" ]; then
  worktree_path="$(hiive worktree add "$branch_name")"
else
  worktree_path="$(hiive worktree add)"
fi

if [ -z "$worktree_path" ]; then
  echo "hiive worktree add did not return a path." >&2
  exit 1
fi

# Resolve which branch is checked out in the worktree
actual_branch="$(git -C "$worktree_path" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"

if [ -z "$actual_branch" ]; then
  actual_branch="${branch_name:-unknown}"
fi

# Auto-trust the worktree in pi if the main repo is already trusted
pi_trust="${HOME}/.pi/agent/trust.json"
if [ -f "$pi_trust" ] && jq -e --arg r "$repo_root" '.[$r] == true' "$pi_trust" > /dev/null 2>&1; then
  jq --arg p "$worktree_path" '.[$p] = true' "$pi_trust" > "${pi_trust}.tmp" && mv "${pi_trust}.tmp" "$pi_trust"
fi

open_in_zellij "$worktree_path" "$repo_name" "$actual_branch"
